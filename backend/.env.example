# Kopiraj u .env i popuni vrednosti. .env se NE commit-uje.

# ── Okruženje ─────────────────────────────────────────────
# production = Render (tamo se postavlja automatski), development = lokalno.
# Van produkcije backend ODBIJA da se poveže na produkcijsku Neon bazu.
APP_ENV=development
DEBUG=True
SECRET_KEY=generisi-dugi-random-string

# ── Baza ──────────────────────────────────────────────────
# Lokalni razvoj: Neon grana "dev" projekta paws_app_db (NE main/produkcija).
# DATABASE_URL=postgresql://<user>:<pass>@<dev-endpoint>.neon.tech/neondb?sslmode=require
# ili lokalni Postgres:
# DB_NAME=paws_db
# DB_USER=paws_user
# DB_PASSWORD=paws_password
# DB_HOST=localhost
# DB_PORT=5432

# Testovi (python manage.py test) uvek koriste SQLite u memoriji.
# Za testove nad Postgres-om postavi zasebnu bazu:
# TEST_DATABASE_URL=postgresql://localhost/paws_test

# ── Produkcija (Render env vars) ──────────────────────────
# APP_ENV=production
# ALLOWED_HOSTS=paws-app.onrender.com
# CORS_ALLOWED_ORIGINS=https://<vercel-domen>
# FRONTEND_URL=https://<vercel-domen>

# ── Zaštita registracije (Cloudflare Turnstile, besplatno) ─
# TURNSTILE_SECRET_KEY=
# TURNSTILE_ENFORCE=False   # True tek kad su web i novi APK sa CAPTCHA-om objavljeni
# REGISTER_THROTTLE_RATE=5/hour
# REGISTER_DAILY_THROTTLE_RATE=15/day
# WALKER_EMAIL_VERIFICATION_REQUIRED_FROM=2026-11-25
# PROTECTED_ADMIN_EMAILS=admin@paws.rs

# ── Email (bez ovoga verifikacioni mejlovi se samo ispisuju u log!) ─
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=PawsApp <noreply@paws.rs>
