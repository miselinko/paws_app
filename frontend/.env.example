# Kopiraj u .env.local i popuni vrednosti

# Produkcija
VITE_API_URL=https://tvoj-app.onrender.com/api
VITE_BACKEND_URL=https://tvoj-app.onrender.com

# Lokalni razvoj — ne treba .env.local, defaulti su localhost:8001

# Cloudflare Turnstile CAPTCHA (javni site key; prazno = CAPTCHA isključena)
VITE_TURNSTILE_SITE_KEY=
